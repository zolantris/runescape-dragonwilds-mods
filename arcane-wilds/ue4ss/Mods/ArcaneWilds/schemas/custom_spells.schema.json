{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arcanewilds.local/schemas/custom_spells.schema.json",
  "title": "Arcane Wilds Custom Spells Configuration",
  "description": "Defines custom spells, progression requirements, staff damage scaling, and animation/VFX/SFX/Hit timelines for Arcane Wilds.",
  "type": "object",
  "required": ["spells"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to the JSON Schema for editor validation and autocomplete."
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for forward-compatible migrations (current: 1)."
    },
    "format": {
      "type": "string",
      "const": "arcane-wilds.custom_spells",
      "description": "Optional format identifier used on exported JSON files."
    },
    "modVersion": {
      "type": "string",
      "description": "Optional Arcane Wilds mod version that generated this file."
    },
    "exportedAt": {
      "type": "string",
      "description": "Optional ISO-8601 timestamp when exported from the editor."
    },
    "spells": {
      "type": "object",
      "description": "Map of internal spell IDs (referenced in combo_rules.json and quick_cast.txt) to custom spell definitions.",
      "minProperties": 0,
      "additionalProperties": {
        "$ref": "#/definitions/CustomSpell"
      }
    }
  },
  "definitions": {
    "Vec3": {
      "description": "3D vector as [x, y, z], {x, y, z}, uniform number, or 'x,y,z' string.",
      "oneOf": [
        { "type": "number" },
        {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1,
          "maxItems": 3
        },
        {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "additionalProperties": false
        },
        { "type": "string" }
      ]
    },
    "Rot3": {
      "description": "3D rotation as [pitch, yaw, roll], {pitch, yaw, roll}, yaw number, or 'p,y,r' string.",
      "oneOf": [
        { "type": "number" },
        {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1,
          "maxItems": 3
        },
        {
          "type": "object",
          "properties": {
            "pitch": { "type": "number" },
            "yaw": { "type": "number" },
            "roll": { "type": "number" }
          },
          "additionalProperties": false
        },
        { "type": "string" }
      ]
    },
    "DamageRange": {
      "description": "Damage roll range as [min, max], {min, max}, flat number, or 'min..max' string.",
      "oneOf": [
        { "type": "number", "minimum": 0 },
        {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(\\.\\.[0-9]+(\\.[0-9]+)?)?$"
        }
      ]
    },
    "Timing": {
      "description": "Cue timing: '@0.00' (absolute sec), '&' or '&+0.10' (sync start with previous), '&id+0.15' (sync start with named cue), '>' or '>-0.10' (after previous cue in lane ends), '>id' (after named cue ends), plain number (seconds), or structured object.",
      "oneOf": [
        { "type": "string" },
        { "type": "number", "minimum": 0 },
        {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["abs", "sync_start", "after_end"] },
            "after": { "type": "string", "description": "Shorthand: start after this named cue id (or 'lane'/'prev') ends." },
            "syncWith": { "type": "string", "description": "Shorthand: start simultaneously with this named cue id (or 'prev')." },
            "offset": { "type": "number", "default": 0 }
          },
          "additionalProperties": false
        }
      ]
    },
    "SpawnPattern": {
      "description": "Multi-point spawn pattern: 'ring:<n>:<radius>', 'line:<n>:<step>', 'arc:<n>:<radius>:<deg>', or structured object.",
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "enum": ["point", "ring", "line", "arc"] },
            "count": { "type": "integer", "minimum": 1 },
            "radius": { "type": "number", "minimum": 0 },
            "step": { "type": "number", "minimum": 0 },
            "arcDeg": { "type": "number", "minimum": 0, "maximum": 360 }
          },
          "additionalProperties": false
        }
      ]
    },
    "TimelineCue": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "anim",
            "weaponAnim",
            "targetAnim",
            "vfx",
            "sfx",
            "actor",
            "spell",
            "hit",
            "decal",
            "shake",
            "chainstrike"
          ],
          "description": "Cue action type executed on the spell timeline."
        },
        "id": {
          "type": "string",
          "description": "Optional unique cue identifier so later cues can anchor via '>id' or '&id+0.10'."
        },
        "at": {
          "$ref": "#/definitions/Timing"
        },
        "asset": {
          "type": "string",
          "description": "UE asset path, short name, or keyword (e.g. 'DA_Spell_Primary_Air_01', 'lightning', or '/Game/...')."
        },
        "target": {
          "type": "string",
          "description": "Spatial target: 'player', 'impact', 'hit_targets', 'targets', 'lock', 'weapon_right', 'weapon_left', 'world', '2d', 'forward:<dist>', or 'actor:<id>'."
        },
        "duration": {
          "description": "Cue duration in seconds, or 'auto'.",
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "string", "enum": ["auto"] }
          ]
        },
        "dur": {
          "description": "Alias for duration.",
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "string", "enum": ["auto"] }
          ]
        },
        "rate": { "type": "number", "minimum": 0.1, "description": "Animation playback rate multiplier." },
        "start": { "type": "number", "minimum": 0, "description": "Start time offset in seconds for Anim/SFX." },
        "slot": {
          "type": "string",
          "description": "Animation slot: 'auto', 'FullBody', 'Spine', 'RightArm', 'LeftArm', 'Legs', 'Pelvis', 'Head', 'Curves', or custom FName."
        },
        "section": { "type": "string", "description": "Optional AnimMontage section name to jump to." },
        "blendIn": { "type": "number", "minimum": 0 },
        "blendOut": { "type": "number", "minimum": 0 },
        "loop": { "type": "integer", "minimum": 1 },
        "stopAll": { "type": "boolean" },
        "syncTo": { "type": "string", "description": "Sync animation playback to an earlier anim cue's id." },
        "attach": { "type": "string", "description": "Attachment target for Actor/VFX ('world', 'player', 'weapon_right', etc.)." },
        "socket": { "type": "string", "description": "Mesh socket/bone name for attachment." },
        "offset": { "$ref": "#/definitions/Vec3" },
        "rot": { "$ref": "#/definitions/Rot3" },
        "scale": {
          "description": "3D scale for VFX/Actor, or damage scaling mode ('full'|'staff'|'magic'|'none') on Hit cues.",
          "oneOf": [
            { "$ref": "#/definitions/Vec3" },
            { "type": "string", "enum": ["full", "staff", "magic", "none"] }
          ]
        },
        "size": { "$ref": "#/definitions/Vec3", "description": "Decal box size [x, y, z]." },
        "pattern": { "$ref": "#/definitions/SpawnPattern" },
        "volume": { "type": "number", "minimum": 0, "description": "SFX volume multiplier." },
        "vol": { "type": "number", "minimum": 0, "description": "Alias for volume." },
        "pitch": { "type": "number", "minimum": 0.1, "description": "SFX pitch multiplier." },
        "radius": { "type": "number", "minimum": 0, "description": "AoE hit or target search radius in cm." },
        "cone": { "type": "number", "minimum": 0, "maximum": 360, "description": "Forward cone angle in degrees." },
        "maxTargets": { "type": "integer", "minimum": 1 },
        "damage": { "$ref": "#/definitions/DamageRange" },
        "dmg": { "$ref": "#/definitions/DamageRange" },
        "damageMin": { "type": "number", "minimum": 0 },
        "damageMax": { "type": "number", "minimum": 0 },
        "damageScaling": {
          "type": "string",
          "enum": ["full", "staff", "magic", "none"],
          "description": "Per-Hit override for damage scaling mode."
        },
        "class": {
          "type": "string",
          "enum": ["Magical", "Melee", "Ranged", "None"],
          "description": "Damage class for Hit cues."
        },
        "force": { "type": "number", "description": "Hit reaction force (used when BPBridge is loaded)." },
        "stun": { "type": "number", "minimum": 0, "description": "Stun duration in seconds (disables enemy movement + attacks and interrupts active montage)." },
        "stunDuration": { "type": "number", "minimum": 0, "description": "Alias for stun duration in seconds." },
        "root": { "type": "number", "minimum": 0, "description": "Root/snare duration in seconds (locks enemy movement in place while still allowing attacks)." },
        "rootDuration": { "type": "number", "minimum": 0, "description": "Alias for root duration in seconds." },
        "snare": { "type": "number", "minimum": 0, "description": "Alias for root duration in seconds." },
        "pushback": { "type": "number", "description": "Horizontal launch velocity in cm/s away from caster/impact center (negative pulls enemies inward; e.g. 600-1200)." },
        "knockback": { "type": "number", "description": "Alias for pushback velocity in cm/s." },
        "launchZ": { "type": "number", "description": "Upward vertical launch velocity in cm/s (defaults to 180 when pushback is set; set 0 for pure horizontal)." },
        "knockup": { "type": "number", "description": "Alias for launchZ vertical velocity in cm/s." },
        "slow": {
          "description": "Slow duration in seconds (defaults to 0.45x speed), 'mult:sec' string, or { multiplier, duration } object.",
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "multiplier": { "type": "number", "minimum": 0.05, "maximum": 0.99 },
                "duration": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": false
            }
          ]
        },
        "slowDuration": { "type": "number", "minimum": 0, "description": "Slow duration in seconds." },
        "slowMultiplier": { "type": "number", "minimum": 0.05, "maximum": 0.99, "description": "Enemy run speed multiplier while slowed (e.g. 0.4 = 40% speed)." },
        "interrupt": { "type": "boolean", "description": "Whether stun interrupts the enemy's active attack montage (default true)." },
        "ge": { "type": "string", "description": "Optional GameplayEffect class applied to hit targets (e.g. 'GE_AddBurning')." },
        "vfx": { "type": "string", "description": "Optional secondary VFX triggered by a Hit or ChainStrike cue." },
        "sfx": { "type": "string", "description": "Optional secondary SFX triggered by a Hit or ChainStrike cue." },
        "trackImpact": { "type": "boolean", "description": "For Spell cues: track projectile collision point so later '>id' cues fire on impact." },
        "impactTimeout": { "type": "number", "minimum": 0.1, "description": "Max seconds to wait for projectile impact before falling back to auto-target." },
        "scaleWithSpeed": { "type": "boolean" },
        "allowUnsafeSpawn": { "type": "boolean" },
        "innerRadius": { "type": "number", "minimum": 0 },
        "outerRadius": { "type": "number", "minimum": 0 },
        "falloff": { "type": "number", "minimum": 0 },
        "range": { "type": "number", "minimum": 0 },
        "requireLock": { "type": "boolean" },
        "los": { "type": "boolean" },
        "skill": { "type": "string" },
        "baseStrikes": { "type": "integer", "minimum": 1 },
        "levelsPerStrike": { "type": "integer", "minimum": 1 },
        "maxStrikes": { "type": "integer", "minimum": 1 },
        "interval": { "type": "number", "minimum": 0.02 },
        "chainRadius": { "type": "number", "minimum": 50 },
        "preferUnique": { "type": "boolean" },
        "vfxFloats": {
          "type": "object",
          "description": "Map of Niagara float user parameter names to numeric values.",
          "additionalProperties": { "type": "number" }
        },
        "vfxVecs": {
          "type": "object",
          "description": "Map of Niagara vector user parameter names to Vec3 values.",
          "additionalProperties": { "$ref": "#/definitions/Vec3" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "hit" } } },
          "then": {
            "properties": {
              "radius": { "type": "number", "minimum": 1 },
              "class": { "type": "string", "enum": ["Magical", "Melee", "Ranged", "None"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["vfx", "sfx", "anim", "weaponAnim", "targetAnim", "spell", "actor", "decal", "shake"] } } },
          "then": {
            "required": ["asset"]
          }
        }
      ]
    },
    "CustomSpell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Set to false to disable this custom spell without deleting it."
        },
        "displayName": {
          "type": "string",
          "description": "Friendly display name shown in HUD notifications and logs."
        },
        "description": {
          "type": "string",
          "description": "Optional author notes or flavor text (ignored at runtime)."
        },
        "category": {
          "type": "string",
          "description": "Elemental or custom category (e.g. 'Air', 'Fire', 'Water', 'Earth', 'Custom')."
        },
        "baseSpell": {
          "type": ["string", "null"],
          "description": "Base DominionSpellData asset name/path (e.g. 'DA_ZamorakStaff_Special'), or 'none'/null for pure timeline/custom spells."
        },
        "suppressBaseSpell": {
          "type": "boolean",
          "default": false,
          "description": "Explicitly suppress casting a native base DominionSpellData."
        },
        "speed": {
          "type": "number",
          "minimum": 0.1,
          "description": "Playback rate multiplier override for this spell."
        },
        "clamp": {
          "type": "boolean",
          "default": false,
          "description": "Apply MaxFinisherSpeedClamp for delayed/notify-sensitive animations."
        },
        "runeCost": {
          "description": "Rune cost as { type, count } or element string (e.g. 'fire', 'air', 'water', 'earth').",
          "oneOf": [
            { "type": "string" },
            { "type": "null" },
            {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "count": { "type": "integer", "minimum": 1, "default": 1 }
              },
              "additionalProperties": false
            }
          ]
        },
        "runeCount": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of runes consumed when runeCost is a string."
        },
        "requiredMagicLevel": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Minimum skill level required to cast this spell (locks automatically when > 0)."
        },
        "requiredSkill": {
          "type": "string",
          "default": "Magic",
          "description": "Skill checked for level gating (e.g. 'Magic', 'Attack', or 'Magic:40')."
        },
        "unlockedByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Whether this spell starts unlocked when requiredMagicLevel is 0."
        },
        "scaleWithStaff": {
          "type": "boolean",
          "description": "Whether Hit/Impact/SpinHitbox damage scales with equipped staff."
        },
        "damageScaling": {
          "type": "string",
          "enum": ["full", "staff", "magic", "none"],
          "description": "full = staff * magic skill * attributes; staff = staff only; magic = skill + attributes; none = flat."
        },
        "staffBaselineTier": {
          "type": "integer",
          "minimum": 1,
          "description": "Staff tier where tier multiplier = 1.0x (defaults to config.txt StaffBaselineTier)."
        },
        "staffTierStep": {
          "type": "number",
          "minimum": 0,
          "description": "Multiplier added per staff tier above baseline."
        },
        "staffBonus": {
          "description": "Optional per-staff substring bonus multipliers, e.g. { \"Armadyl\": 1.35, \"Zamorak\": 1.25 }.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
            },
            { "type": "string" }
          ]
        },
        "timelineDuration": {
          "description": "Total timeline duration in seconds or 'auto'.",
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "string", "enum": ["auto"] }
          ]
        },
        "stepAdvanceAt": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds after cast start when combo_rules can advance to the next step."
        },
        "cancelOnRelease": {
          "type": "boolean",
          "default": false,
          "description": "Cancel active timeline immediately when the modifier/cast key is released."
        },
        "overlapPolicy": {
          "type": "string",
          "enum": ["replace", "parallel", "ignore"],
          "default": "replace",
          "description": "Behavior when recasting while an existing timeline for this spell is still active."
        },
        "scaleTimelineWithSpeed": {
          "type": "boolean",
          "default": true,
          "description": "Scale timeline timing proportionally with cast speed."
        },
        "autoTarget": {
          "type": "object",
          "description": "Auto-target fallback settings when no enemy is locked on (range in UE cm; 100 = 1m).",
          "properties": {
            "range": { "type": "number", "minimum": 100 },
            "cone": { "type": "number", "minimum": 5, "maximum": 360 }
          },
          "additionalProperties": false
        },
        "autoTargetRange": { "type": "number", "minimum": 100 },
        "autoTargetCone": { "type": "number", "minimum": 5, "maximum": 360 },
        "cues": {
          "type": "array",
          "description": "Ordered list of timeline cues (Anim, VFX, SFX, Spell, Hit, Actor, Decal, Shake, ChainStrike).",
          "items": {
            "$ref": "#/definitions/TimelineCue"
          }
        },
        "spawnActor": { "type": "string", "description": "Legacy flat field: Blueprint/Actor class to spawn." },
        "allowUnsafeSpawn": { "type": "boolean" },
        "montage": { "type": "string", "description": "Legacy flat field: AnimMontage override." },
        "skipMontage": { "type": "boolean" },
        "vfx": { "type": "string", "description": "Legacy flat field: NiagaraSystem override." },
        "sfx": { "type": "string", "description": "Legacy flat field: SoundBase override." },
        "spinHitbox": { "type": "boolean", "description": "Legacy flat field: enable around-player AoE hitbox." },
        "hitRadius": { "type": "number", "minimum": 0 },
        "hitDamageMin": { "type": "number", "minimum": 0 },
        "hitDamageMax": { "type": "number", "minimum": 0 },
        "hitDelaySec": { "type": "number", "minimum": 0 },
        "hitVfx": { "type": "string" },
        "hitSfx": { "type": "string" },
        "damageClass": { "type": "string", "enum": ["Magical", "Melee", "Ranged", "None"] },
        "damageForce": { "type": "number" },
        "damageGE": { "type": "string" },
        "damageSpell": { "type": "string" },
        "extraAoEDelaySec": { "type": "number", "minimum": 0 },
        "floatieOffsetZ": { "type": "number" },
        "forceFloatie": { "type": "boolean" },
        "suppressDirectHealth": { "type": "boolean" },
        "impactAoE": { "type": "string" },
        "impactLightning": { "type": "string" },
        "impactVfx": { "type": "string" },
        "impactSfx": { "type": "string" },
        "impactDamageMin": { "type": "number", "minimum": 0 },
        "impactDamageMax": { "type": "number", "minimum": 0 },
        "impactRadius": { "type": "number", "minimum": 0 },
        "bridgeBlueprint": { "type": "string" }
      }
    }
  }
}
