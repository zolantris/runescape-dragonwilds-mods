{
  "schema": 1,
  "mod": {
    "id": "CenteredPanels",
    "name": "Centered Panels (Ultrawide)",
    "version": "1.2.9",
    "author": "Custom",
    "description": "Centers Inventory, Chests, Crafting Stations, and Pause Menu on 32:9 monitors while leaving your HUD untouched for Rune UI.",
    "configFile": "config.txt",
    "format": "kv",
    "controls": [
      {
        "type": "toggle",
        "key": "Enabled",
        "label": "Enable Centered Panels",
        "default": true
      },
      {
        "type": "toggle",
        "key": "CenterInventory",
        "label": "Center Player Inventory",
        "default": true
      },
      {
        "type": "toggle",
        "key": "CenterContainers",
        "label": "Center Chests & Storage",
        "default": true
      },
      {
        "type": "toggle",
        "key": "CenterStations",
        "label": "Center Crafting & Processing Stations",
        "default": true
      },
      {
        "type": "toggle",
        "key": "CenterPauseMenu",
        "label": "Center Pause & Save Menu",
        "default": true
      },
      {
        "type": "slider",
        "key": "MinX",
        "label": "Safe Zone Left Edge (MinX: 0.25 = 16:9 on 32:9)",
        "min": 0.0,
        "max": 0.45,
        "step": 0.01,
        "default": 0.25
      },
      {
        "type": "slider",
        "key": "MaxX",
        "label": "Safe Zone Right Edge (MaxX: 0.75 = 16:9 on 32:9)",
        "min": 0.55,
        "max": 1.0,
        "step": 0.01,
        "default": 0.75
      },
      {
        "type": "slider",
        "key": "OffsetX",
        "label": "Extra Horizontal Shift X (px) [NumPad +/-]",
        "min": -1500,
        "max": 1500,
        "step": 10,
        "default": 0
      }
    ]
  }
}
